# Copy to .env and adjust (`make setup` does this and generates JWT_SECRET).
# Read by docker compose and the backend.
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trading
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trading
# At least 32 characters; the API refuses to start without it.
JWT_SECRET=
# Largest price file accepted by POST /api/market-data/import (MB).
MAX_UPLOAD_MB=200
