    "description": "Buy when the close crosses above the 50-bar SMA with RSI above 50; trail 3 ATRs under the 22-bar high, and leave after 240 bars at the latest.",
    "definition": {
      "direction": "long",
      "entry": {
        "all": [
          {
            "left": { "price": "close" },
            "op": "crosses_above",
