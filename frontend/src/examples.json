  {
    "name": "Double bottom after a dip",
    "description": "The 50-bar SMA crossed below 100 within 48 bars, and price made two swing lows within 0.5% of each other within 48 bars: buy 0.3% above the latest low, for 6 bars, with the stop 1% under it and the target at twice the risk.",
    "definition": {
      "direction": "long",
      "entry": {
        "all": [
          {
