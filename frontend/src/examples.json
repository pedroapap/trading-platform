              "left": { "indicator": "sma", "period": 50 },
              "op": "crosses_below",
              "right": { "value": 100 }
            },
            "within": 48
          },
          {
            "pattern": "equal_lows",
            "strength": 3,
            "times": 2,
            "within": 48,
            "tolerance_pct": 0.5
          }
        ]
      },
      "entry_order": {
        "type": "limit",
        "price": { "multiply": [{ "indicator": "swing_low", "strength": 3 }, { "value": 1.003 }] },
        "expires_after": 6
      },
      "stop_loss_at": {
        "multiply": [{ "indicator": "swing_low", "strength": 3 }, { "value": 0.99 }]
      },
      "take_profit_r": 2
    }
  },
